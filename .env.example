# Copy this file to `.env` and fill in your key.
#
#   cp .env.example .env
#
# `.env` is gitignored. The config YAML deliberately does NOT hold the key so
# you can share or version the config without leaking credentials.
#
# Get a key at https://app.rentcast.io/app/api
#
# NOTE: if a key of yours has ever been pasted into a chat window, an email,
# or a commit, treat it as compromised and rotate it before using it here.

RENTCAST_API_KEY=your_key_here
